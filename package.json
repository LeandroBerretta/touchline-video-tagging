{
  "name": "my-web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test --test-concurrency=4 \"test/*.test.js\"",
    "prepare": "node -e \"try { require('child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }) } catch {}\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^24.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
